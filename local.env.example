# Copy to local.env (gitignored) and fill in. Environment variables of the same
# name override these. See docs/SETUP.md.

# The Master Collection install: the folder holding METAL GEAR SOLID2.exe
MGS2_GAME=C:/Program Files (x86)/Steam/steamapps/common/MGS2

# Root of your copy of the leaked source tree: the folder holding mgs2x/ and bp/
MGS2_LEAK=D:/mgs2-source

# Folder with gclconv.exe and gclk.exe, if not <MGS2_LEAK>/bp/Bin/Tools/Release
#MGS2_GCL_BIN=

# Your own models, textures and audio for a restoration that needs them
# (see restorations/manhattan-crash/ASSETS.md)
#MGS2_ASSETS=D:/mgs2-assets

# Scratch space for builds (default: <repo>/build)
#MGS2_BUILD=

